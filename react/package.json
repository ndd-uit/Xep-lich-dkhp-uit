{
  "name": "dkhp-uit-react",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/styles": "^6.4.8",
    "ag-grid-community": "^36.1.0",
    "ag-grid-enterprise": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "clsx": "^2.0.0",
    "constate": "^4.0.0",
    "html2canvas": "^1.4.1",
    "lodash": "^4.17.21",
    "notistack": "^3.0.2",
    "proxy-memoize": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "react-router-dom": "^7.18.2",
    "use-debounce": "^10.1.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env GENERATE_SOURCEMAP=false react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 --color \"./src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix --color \"./src/**/*.{js,jsx,ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\" \"public/**/*.{html,json}\" \"*.{js,json,md}\" \"../README.md\" \"../.github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,md}\" \"public/**/*.{html,json}\" \"*.{js,json,md}\" \"../README.md\" \"../.github/**/*.yml\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci",
    "eject": "react-scripts eject"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/react-dom": "^19.2.4",
    "@types/react-router-dom": "^5.1.8",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-config-react-app": "^7.0.1",
    "prettier": "^3.9.6",
    "react-scripts": "^5.0.1",
    "typescript": "^7.0.2"
  }
}
